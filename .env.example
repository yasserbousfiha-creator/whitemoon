# Supabase (Project Settings → API Keys). The secret key is server-only — never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Public site address, used for the dashboard link in booking emails
SITE_URL=https://whitemoon-wheat.vercel.app

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=sender@gmail.com
SMTP_PASS=app-password
# SMTP_FROM="White Moon <sender@gmail.com>"

# Fallback recipient when no specific route below is set
BOOKING_TO_DEFAULT=info@example.com

# Recipient per specialty (dentistry | derma | laser) and branch (khamseen | shahar | wisam)
BOOKING_TO_DENTISTRY_KHAMSEEN=
BOOKING_TO_DENTISTRY_SHAHAR=
BOOKING_TO_DENTISTRY_WISAM=
BOOKING_TO_DERMA_KHAMSEEN=
BOOKING_TO_DERMA_SHAHAR=
BOOKING_TO_DERMA_WISAM=
BOOKING_TO_LASER_KHAMSEEN=
BOOKING_TO_LASER_SHAHAR=
BOOKING_TO_LASER_WISAM=
